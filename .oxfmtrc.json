{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "experimentalSortImports": {},
  "ignorePatterns": [
    "package.json",
    "src/routeTree.gen.ts",
    "drizzle/**",
    "worker-configuration.d.ts",
    "node_modules/**",
    "dist/**",
    ".vscode/settings.json",
    ".claude/settings.json",
    "opencode.jsonc",
    ".github/copilot-instructions.md",
    ".github/instructions/**",
    "rulesync.local.jsonc"
  ],
  "overrides": [
    {
      "files": ["**/*.json", "**/*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
