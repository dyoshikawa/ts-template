{
  "name": "ts-template",
  "version": "0.0.0",
  "private": true,
  "description": "Opinionated TypeScript web app template: TanStack Start on Cloudflare Workers with email sign-in, PWA install and push notifications",
  "keywords": [
    "cloudflare-workers",
    "pwa",
    "react",
    "tanstack-start",
    "template",
    "typescript"
  ],
  "homepage": "https://github.com/dyoshikawa/ts-template#readme",
  "bugs": {
    "url": "https://github.com/dyoshikawa/ts-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dyoshikawa/ts-template.git"
  },
  "license": "MIT",
  "author": "dyoshikawa",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "cf-typegen": "wrangler types --strict-vars=false",
    "check": "vp check --deny-warnings && pnpm run typecheck",
    "cicheck": "pnpm run cicheck:code && pnpm run cicheck:content",
    "cicheck:code": "pnpm run check && pnpm run test",
    "cicheck:content": "pnpm run cspell && pnpm run secretlint",
    "cspell": "cspell --no-progress --gitignore --dot .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:reset:local": "node scripts/reset-local-db.mjs",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "vp dev",
    "dev:cf": "node scripts/cf-dev.mjs",
    "dev:cf:fresh": "node scripts/cf-dev.mjs --fresh",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "fix": "vp check --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "generate": "rulesync generate",
    "icons": "node scripts/generate-icons.mjs",
    "knip": "knip",
    "oxlint": "vp lint --max-warnings 0",
    "oxlint:fix": "vp lint --fix --max-warnings 0",
    "prepare": "vp config --no-agent && pnpm generate",
    "preview": "vp preview",
    "secretlint": "secretlint --secretlintignore .gitignore \"**/*\"",
    "sort": "sort-package-json",
    "test": "vp test run --silent=true",
    "test:coverage": "vp test run --coverage --silent=true",
    "test:watch": "vp test --silent=true",
    "typecheck": "tsc --noEmit",
    "vapid": "node scripts/generate-vapid-keys.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.13",
    "@better-auth/passkey": "1.7.13",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.7.13",
    "drizzle-orm": "0.45.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@playwright/test": "1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "catalog:",
    "cspell": "10.4.0",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rulesync": "41.0.0",
    "secretlint": "13.1.0",
    "sort-package-json": "4.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=10"
  }
}
