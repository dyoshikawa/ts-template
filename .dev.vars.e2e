# Variables for the browser tests (`pnpm e2e`) and for a local run without
# Turnstile. `scripts/cf-dev.mjs --vars .dev.vars.e2e` builds them into the
# emulator's bundle (see `localVars` in cloudflare.config.ts); never set these
# on the deployed Worker.
BETTER_AUTH_SECRET=insecure-e2e-only-secret-do-not-use-in-production
TURNSTILE_DISABLED=1
E2E_SIGN_IN_CODE=12345678
# A throwaway VAPID pair for the notification tests (no push ever leaves the
# emulator with it). Generate your own with `pnpm vapid` for real use.
VAPID_PUBLIC_KEY=BB4t0EP9ulF65qICyG78IxjWvNrAhgOX_aSJm0hY3T3DQze82BNAoEutpXTJkB1JXVDU5NeG0zhj1JC-FERAOeY
