{
  "cache": {
    "useCache": true,
    "cacheLocation": ".cspellcache"
  },
  "useGitignore": true,
  "files": [
    "**/*.{ts,tsx,js,jsx,mjs,cjs}",
    "**/*.{json,yaml,yml}",
    "**/*.md",
    "*.{json,yaml,yml,md}"
