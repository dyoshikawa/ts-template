{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/permissions-schema.json",
  // Nothing that reaches production (`pnpm run deploy`, `pnpm run
  // db:migrate:remote`) is pre-approved: an agent asks first. Add allow rules
  // here per project once that is what you want.
  "permission": {},
  "codexcli": {
    "base_permission_profile": ":danger-full-access",
    "approvals_reviewer": "auto_review",
    "approval_policy": "on-request"
  }
}
